{
  "name": "pastagansa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pastagansa/api",
    "build": "npm run build --workspace=@pastagansa/api",
    "lint": "npm run lint --workspace=@pastagansa/api",
    "test": "npm run test --workspace=@pastagansa/api",
    "test:integration": "npm run test:integration --workspace=@pastagansa/api",
    "db:generate": "npm run db:generate --workspace=@pastagansa/api",
    "db:migrate": "npm run db:migrate --workspace=@pastagansa/api",
    "db:deploy": "npm run db:deploy --workspace=@pastagansa/api"
  },
  "dependencies": {
    "@nestjs/platform-express": "11.2.3",
    "multer": "2.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "$multer"
    }
  }
}
