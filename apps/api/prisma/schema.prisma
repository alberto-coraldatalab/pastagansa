generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum CatalogItemStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CASH
  CARD
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  companies   Company[]
  memberships Membership[]
  auditEvents AuditEvent[]
  contacts    Contact[]
  contactAddresses ContactAddress[]
  catalogItems CatalogItem[]
  @@map("organizations")
}

model Company {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  legalName      String       @map("legal_name")
  taxId          String       @map("tax_id") @db.VarChar(40)
  country        String       @default("ES") @db.Char(2)
  baseCurrency   String       @default("EUR") @map("base_currency") @db.Char(3)
  timezone       String       @default("Europe/Madrid") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  auditEvents    AuditEvent[]
  contacts       Contact[]
  contactAddresses ContactAddress[]
  catalogItems   CatalogItem[]
  @@unique([organizationId, taxId])
  @@index([organizationId])
  @@map("companies")
}

model CatalogItem {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  type                  CatalogItemType
  sku                   String?           @db.VarChar(80)
  name                  String            @db.VarChar(240)
  description           String?
  unit                  String            @default("unit") @db.VarChar(30)
  salesPrice            Decimal?          @map("sales_price") @db.Decimal(14, 2)
  currency              String            @default("EUR") @db.Char(3)
  suggestedTaxCode      String?           @map("suggested_tax_code") @db.VarChar(80)
  revenueAccountCode    String?           @map("revenue_account_code") @db.VarChar(20)
  expenseAccountCode    String?           @map("expense_account_code") @db.VarChar(20)
  trackInventory        Boolean           @default(false) @map("track_inventory")
  status                CatalogItemStatus @default(ACTIVE)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  @@unique([companyId, sku])
  @@index([companyId, status, name])
  @@map("catalog_items")
}

model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  legalName      String        @map("legal_name") @db.VarChar(240)
  tradeName      String?       @map("trade_name") @db.VarChar(240)
  taxId          String?       @map("tax_id") @db.VarChar(40)
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(40)
  paymentTermsDays Int?        @map("payment_terms_days")
  paymentMethod  PaymentMethod? @map("payment_method")
  isCustomer     Boolean       @default(false) @map("is_customer")
  isSupplier     Boolean       @default(false) @map("is_supplier")
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addresses      ContactAddress[]
  @@unique([companyId, taxId])
  @@index([companyId, status, legalName])
  @@map("contacts")
}

model ContactAddress {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  contactId      String      @map("contact_id") @db.Uuid
  type           AddressType @default(BILLING)
  label          String?     @db.VarChar(120)
  line1          String      @db.VarChar(240)
  line2          String?     @db.VarChar(240)
  postalCode     String      @map("postal_code") @db.VarChar(20)
  city           String      @db.VarChar(120)
  province       String?     @db.VarChar(120)
  country        String      @default("ES") @db.Char(2)
  isDefault      Boolean     @default(false) @map("is_default")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(6)
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  @@index([companyId, contactId, archivedAt])
  @@map("contact_addresses")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.Citext
  passwordHash String?      @map("password_hash")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships  Membership[]
  auditEvents  AuditEvent[] @relation("actor_audit_events")
  sessions     Session[]
  @@map("users")
}

model Session {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  refreshHash  String        @map("refresh_hash")
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime?     @map("last_used_at") @db.Timestamptz(6)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@map("sessions")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(80)
  name        String
  memberships Membership[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique @db.VarChar(120)
  name  String
  roles RolePermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([organizationId, companyId, userId, roleId])
  @@index([userId, organizationId, companyId])
  @@map("memberships")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(160)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User?        @relation("actor_audit_events", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, companyId, occurredAt])
  @@map("audit_events")
}
